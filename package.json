{
	"name": "bauchgefuehl",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"pb": "./pocketbase/pocketbase serve --dir ./pocketbase/pb_data --migrationsDir ./pocketbase/pb_migrations --hooksDir ./pocketbase/pb_hooks",
		"pb:get": "sh scripts/get-pocketbase.sh",
		"icons": "node scripts/make-icons.mjs",
		"prompts": "BILDPROMPTS=1 vitest --run bildprompts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"jspdf": "^4.2.1",
		"pocketbase": "^0.29.0"
	},
	"engines": {
		"node": ">=22"
	}
}
